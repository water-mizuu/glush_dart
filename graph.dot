digraph StateMachine {
  rankdir=LR;
  node [fontname="Courier"];
  "__start__" [shape=point, label=""];
  "__accept__" [shape=doublecircle, label="accept"];
  "__return_0__" [shape=box, label="return 0", style=filled, fillcolor=lightgray];
  "__return_4__" [shape=box, label="return 4", style=filled, fillcolor=lightgray];
  "S0" [shape=circle, label="init"];
  "S1" [shape=circle, label="<A>"];
  "S2" [shape=circle, label="<A>"];
  "S3" [shape=circle, label="x"];
  "S4" [shape=circle, label="<B>"];
  "S5" [shape=circle, label="<B>"];
  "S6" [shape=circle, label="y"];
  "S7" [shape=circle, label="z"];
  "S8" [shape=circle, label="<A>"];
  "__start__" -> "S0" [label="start"];
  "S0" -> "S1" [label="call 0", style=bold];
  "S1" -> "__accept__" [label="accept"];
  "S2" -> "S3" [label="token x"];
  "S3" -> "S3" [label="tail call 4", style=bold];
  "S4" -> "__return_0__" [label="return A", style=dashed, color=gray45];
  "S5" -> "S6" [label="token y"];
  "S5" -> "S7" [label="token z"];
  "S6" -> "S6" [label="tail call 0", style=bold];
  "S7" -> "__return_4__" [label="return B", style=dashed, color=gray45];
  "S8" -> "__return_4__" [label="return B", style=dashed, color=gray45];
}
